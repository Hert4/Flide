FROM python:3.12-slim-bookworm
# torch cu126: Run:AI nodes run driver 570 (CUDA 12.8).
RUN pip install --no-cache-dir "torch==2.14.1" torchvision --index-url https://download.pytorch.org/whl/cu126
COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES /src/
COPY flide /src/flide
COPY plugins /src/plugins
RUN pip install --no-cache-dir /src && rm -rf /src \
 && python -c "import torch, flide, fla, transformers, torchvision; from flide.formats.next_token import bind_assets; print(torch.__version__, torch.version.cuda, transformers.__version__)"
ENV HF_HUB_OFFLINE=1
EXPOSE 8000
ENTRYPOINT ["flide"]
CMD ["serve", "--help"]
